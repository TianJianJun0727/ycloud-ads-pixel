{
  "name": "@ycloud-web/ads-pixel",
  "version": "1.0.0-beta.1",
  "description": "Unified browser Ads Pixel SDK for Google Tag, Meta Pixel, and OpenAI Ads Pixel.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/umd/index.js",
  "jsdelivr": "./dist/umd/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.10.6",
    "@rstest/core": "^0.10.6",
    "@types/node": "^24.13.2",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.11.1",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
