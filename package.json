{
  "name": "@ycloud/ads-ads-pixel",
  "version": "2.0.0-beta.1",
  "description": "Unified browser Ads Pixel SDK for Google Tag, Meta Pixel, OpenAI Ads Pixel, and LinkedIn Insight Tag.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/umd/index.js",
  "jsdelivr": "./dist/umd/index.js",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.ycloud.com/"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings .",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "format:check": "oxfmt --check .",
    "prepare": "node .husky/install.mjs",
    "prepack": "pnpm run build",
    "release": "release-it --git.tagExclude='*.*.*-*'",
    "release:beta": "release-it --preRelease=beta"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.2",
    "@rslib/core": "^1.0.7",
    "@rstest/adapter-rslib": "^0.12.6",
    "@rstest/core": "^0.12.6",
    "@types/node": "^26.6.6",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "release-it": "^21.1.3",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianJianJun0727/ycloud-ads-pixel.git"
  },
  "homepage": "https://github.com/TianJianJun0727/ycloud-ads-pixel#readme",
  "bugs": {
    "url": "https://github.com/TianJianJun0727/ycloud-ads-pixel/issues"
  },
  "keywords": [
    "ads",
    "conversion-tracking",
    "google-tag",
    "meta-pixel",
    "openai-ads",
    "linkedin-insight-tag"
  ],
  "packageManager": "pnpm@12.23.0",
  "lint-staged": {
    "*.{js,cjs,mjs,ts,cts,mts}": [
      "oxfmt --write",
      "oxfmt --check",
      "oxlint --deny-warnings"
    ],
    "!(pnpm-lock|CHANGELOG).{json,jsonc,md,yaml,yml}": [
      "oxfmt --write",
      "oxfmt --check"
    ]
  }
}
